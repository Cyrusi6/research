{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evidence_id",
    "attempt_id",
    "producer_run_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_semantic_hash",
    "variant_spec_hash",
    "trial_spec_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "evaluator_hash",
    "cross_references",
    "probe_id",
    "status",
    "command_status",
    "exit_code",
    "expected_surface_ids",
    "observed_surface_ids",
    "activation_delta_threshold",
    "surface_measurements",
    "lifecycle_generation",
    "implementation_hash",
    "attempt_input_hash",
    "phase",
    "phase_execution_id",
    "phase_start_event_id"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_activation_evidence_v4"
    },
    "evidence_kind": {
      "const": "activation_evidence"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 8
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 8
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cross_references": {
      "type": "object",
      "additionalProperties": false
    },
    "probe_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {"enum": ["activated", "not_activated", "command_failed"]},
    "command_status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "expected_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_surface_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "activation_delta_threshold": {"type": "number"},
    "surface_measurements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface_id", "enabled_value", "disabled_value", "delta", "threshold", "status"],
        "properties": {
          "surface_id": {"type": "string", "minLength": 1},
          "enabled_value": {"type": "number"},
          "disabled_value": {"type": "number"},
          "delta": {"type": "number"},
          "threshold": {"type": "number"},
          "status": {"enum": ["ACTIVATED", "NOT_ACTIVATED"]}
        }
      }
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "activation",
        "proxy",
        "full",
        "resource",
        "resume"
      ]
    },
    "phase_execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "phase_start_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["activated", "not_activated"]
          }
        }
      },
      "then": {
        "properties": {
          "command_status": {
            "const": "completed"
          },
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "command_failed"
          }
        }
      },
      "then": {
        "properties": {
          "command_status": {
            "const": "failed"
          },
          "exit_code": {
            "not": {
              "const": 0
            }
          }
        }
      }
    }
  ]
}

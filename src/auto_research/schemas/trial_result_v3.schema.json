{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "direction_id", "direction_semantic_hash", "direction_spec_hash", "variant_id", "variant_semantic_hash", "variant_spec_hash", "attempt_id", "trial_spec_hash", "acceptance_contract_hash", "protocol_hash", "attempt_input_hash", "completeness", "required_datasets", "observed_datasets", "raw_artifacts", "evidence_manifest", "observations", "constraint_results", "all_hard_constraints_passed", "method_evaluable", "outcome_classification", "failure_classification", "primary_metric_summary"],
  "properties": {
    "schema_version": {"const": "auto_research_trial_result_v3"},
    "direction_id": {"type": "string", "minLength": 1},
    "direction_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "direction_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "variant_id": {"type": "string", "minLength": 1},
    "variant_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "variant_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt_id": {"type": "string", "minLength": 1},
    "trial_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acceptance_contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt_input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completeness": {"enum": ["proxy", "full"]},
    "required_datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "raw_artifacts": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "evidence_manifest": {"$ref": "#/$defs/evidenceManifest"},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "constraint_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constraintResult"}},
    "all_hard_constraints_passed": {"type": "boolean"},
    "method_evaluable": {"const": true},
    "outcome_classification": {"enum": ["accepted", "rejected"]},
    "failure_classification": {"type": "null"},
    "primary_metric_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "objective", "aggregation", "candidate_mean", "baseline_mean", "delta"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "objective": {"enum": ["maximize", "minimize"]},
        "aggregation": {"const": "mean"},
        "candidate_mean": {"type": "number"},
        "baseline_mean": {"type": "number"},
        "delta": {"type": "number"}
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "observation_id", "phase", "role", "command_status", "dataset_id", "metric_id", "metric_value", "sample_manifest_hash", "evaluator_hash", "seed", "raw_artifact_path", "raw_artifact_hash"],
      "properties": {
        "schema_version": {"const": "auto_research_execution_observation_v2"},
        "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
        "phase": {"enum": ["proxy", "full", "ablation"]},
        "role": {"enum": ["baseline", "candidate", "ablation", "matched_control", "coverage"]},
        "command_status": {"const": "completed"},
        "dataset_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "metric_value": {"type": "number"},
        "sample_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluator_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "seed": {"type": "integer", "minimum": 0},
        "raw_artifact_path": {"type": "string", "minLength": 1},
        "raw_artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "constraintResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "constraint_id", "kind", "hard", "status", "observed", "threshold", "objective", "observation_ids", "evidence_ids"],
      "properties": {
        "schema_version": {"const": "auto_research_constraint_result_v1"},
        "constraint_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["minimum_mean_delta", "per_dataset_maximum_regression", "required_ablation_contrast", "matched_control_constraint", "coverage_constraint", "required_artifact_evidence", "primary_metric_threshold", "secondary_metric_threshold"]},
        "hard": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "MISSING"]},
        "observed": {},
        "threshold": {"type": ["number", "null"]},
        "objective": {"type": ["string", "null"], "enum": ["maximize", "minimize", null]},
        "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidenceManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trial_spec_hash", "attempt_id", "entries"],
      "properties": {
        "schema_version": {"const": "auto_research_evidence_manifest_v1"},
        "trial_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attempt_id": {"type": "string", "minLength": 1},
        "entries": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "kind", "relative_path", "content_hash", "schema_version", "attempt_id", "variant_spec_hash", "trial_spec_hash", "cross_references"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 8},
              "kind": {"enum": ["proxy_baseline_fingerprint", "proxy_cache_report", "effective_proxy_policy", "proxy_calibration_policy", "proxy_decision_report", "full_s3_readiness", "activation_evidence", "bootstrap_completion", "main_results", "ablation_results", "coverage_results", "matched_control_results"]},
              "relative_path": {"type": "string", "minLength": 1},
              "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "schema_version": {"type": "string", "minLength": 1},
              "attempt_id": {"type": "string", "minLength": 1},
              "variant_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "trial_spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "baseline_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "cross_references": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
            }
          }
        }
      }
    }
  }
}

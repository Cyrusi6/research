    "retriever_version": {"type": "string"},
    "request_plan_id": {"type": "string"},
    "requests": {"type": "array"},
    "evidence_requests": {"type": "array"},
    "candidate_counts": {"type": "object"},
    "selected_refs": {"type": "array"},

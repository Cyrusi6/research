  "required": [
    "schema_version",
    "direction_id",
    "retriever_version",
    "request_plan_id",
    "requests",
    "evidence_requests",
    "candidate_counts",
    "selected_refs",
    "resolved_ref_count",
    "unresolved_ref_count",
    "resolved_refs",
    "unresolved_refs",
    "unfilled_must_resolve_requests",
    "coverage",
    "coverage_contributors",
    "deterministic",
    "retrieval_inputs_hash",
    "quality_gate",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "identity",
    "next_action",
    "reason_codes",
    "budget_snapshot",
    "artifact_hashes",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_route_outcome_v2"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "attempt_id"
      ],
      "properties": {
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction_id",
        "direction_semantic_hash",
        "direction_spec_hash",
        "variant_id",
        "variant_semantic_hash",
        "variant_spec_hash",
        "attempt_id"
      ],
      "properties": {
        "direction_id": {
          "type": "string",
          "minLength": 1
        },
        "direction_semantic_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "direction_spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_semantic_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "variant_spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next_action": {
      "enum": [
        "IMPLEMENT_VARIANT",
        "REPAIR_IMPLEMENTATION",
        "RUN_METHOD_ATTEMPT",
        "PROPOSE_NEXT_VARIANT",
        "START_NEW_DIRECTION",
        "FINISH_DIRECTION",
        "FINISH_RUN",
        "PAUSE_RESOURCE",
        "BLOCK_INTEGRITY"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reserved",
        "consumed"
      ],
      "properties": {
        "target": {
          "const": 5
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "consumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "allOf": [
        {
          "if": {},
          "then": {}
        }
      ]
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

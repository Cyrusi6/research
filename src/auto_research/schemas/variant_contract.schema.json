{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearchVariantContract",
  "type": "object",
  "required": [
    "direction_id",
    "variant_id",
    "variant_fingerprint",
    "mechanism_axis",
    "integration_point",
    "control_signal",
    "hypothesis",
    "expected_files",
    "implementation_surface_refs",
    "resource_budget",
    "expected_metric_signature",
    "ablation",
    "acceptance",
    "failure_routing"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "direction_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "title": {"type": "string"},
    "mode": {"type": "string"},
    "variant_fingerprint": {"type": "string"},
    "mechanism_axis": {"type": "string"},
    "integration_point": {"type": "string"},
    "control_signal": {"type": "string"},
    "hypothesis": {"type": "string"},
    "why_next": {"type": "string"},
    "expected_files": {"type": "array", "minItems": 1},
    "implementation_surface_refs": {"type": "array", "minItems": 1},
    "resource_budget": {"type": "object"},
    "expected_metric_signature": {"type": "object"},
    "ablation": {"type": "object"},
    "acceptance": {"type": "object"},
    "failure_routing": {"type": "object"},
    "used_shared_memory_refs": {"type": "array"}
  }
}

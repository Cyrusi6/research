{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearchVariantContract",
  "type": "object",
  "required": [
    "direction_id",
    "variant_id",
    "variant_fingerprint",
    "mechanism_axis",
    "integration_point",
    "control_signal",
    "hypothesis",
    "expected_files",
    "implementation_surface_refs",
    "resource_budget",
    "expected_metric_signature",
    "ablation",
    "acceptance",
    "failure_routing"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "direction_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "title": {"type": "string"},
    "mode": {"type": "string"},
    "variant_fingerprint": {"type": "string"},
    "mechanism_axis": {"type": "string"},
    "integration_point": {"type": "string"},
    "control_signal": {"type": "string"},
    "hypothesis": {"type": "string"},
    "experiment_hypothesis": {
      "type": "object",
      "required": ["intervention", "null_hypothesis", "alternative_hypothesis", "minimum_effect", "mechanism_predictions", "falsification_conditions"],
      "properties": {
        "intervention": {"type": "object"},
        "null_hypothesis": {"type": "string"},
        "alternative_hypothesis": {"type": "string"},
        "minimum_effect": {},
        "mechanism_predictions": {"type": "array", "minItems": 1},
        "falsification_conditions": {"type": "array", "minItems": 1}
      }
    },
    "variable_control": {
      "type": "object",
      "required": ["treatment_variables", "fixed_variables", "nuisance_variables", "forbidden_simultaneous_changes"],
      "properties": {
        "treatment_variables": {"type": "array", "minItems": 1},
        "fixed_variables": {"type": "object"},
        "nuisance_variables": {"type": "array"},
        "forbidden_simultaneous_changes": {"type": "array", "minItems": 1}
      }
    },
    "why_next": {"type": "string"},
    "expected_files": {"type": "array", "minItems": 1},
    "implementation_surface_refs": {"type": "array", "minItems": 1},
    "resource_budget": {"type": "object"},
    "expected_metric_signature": {"type": "object"},
    "ablation": {"type": "object"},
    "acceptance": {"type": "object"},
    "failure_routing": {"type": "object"},
    "used_shared_memory_refs": {"type": "array"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_locator", "files"],
  "properties": {
    "schema_version": {"const": "auto_research_c2c_checkpoint_manifest_v1"},
    "root_locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "content_hash", "contract_ref"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "content_hash": {"$ref": "#/$defs/hash"},
          "contract_ref": {"$ref": "#/$defs/blob"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"],
      "properties": {
        "schema_version": {"const": "auto_research_contract_blob_v1"},
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "relative_path": {
          "type": "string",
          "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearchDirectionContract",
  "type": "object",
  "required": [
    "direction_id",
    "mechanism_axis",
    "integration_point",
    "control_signal",
    "hypothesis",
    "why_baseline_fails",
    "expected_metric_signature",
    "required_evidence_refs",
    "counterevidence_refs",
    "implementation_surface_refs",
    "known_negative_memory_refs",
    "go_to_s2_conditions",
    "return_to_s1_conditions"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "direction_id": {"type": "string"},
    "title": {"type": "string"},
    "mechanism_type": {"type": "string"},
    "mechanism_axis": {"type": "string"},
    "integration_point": {"type": "string"},
    "control_signal": {"type": "string"},
    "hypothesis": {"type": "string"},
    "why_baseline_fails": {"type": "string"},
    "expected_metric_signature": {"type": "object"},
    "required_evidence_refs": {"type": "array", "minItems": 1},
    "counterevidence_refs": {"type": "array", "minItems": 1},
    "implementation_surface_refs": {"type": "array", "minItems": 1},
    "known_negative_memory_refs": {"type": "array"},
    "go_to_s2_conditions": {"type": "array", "minItems": 1},
    "return_to_s1_conditions": {"type": "array", "minItems": 1},
    "allowed_variants": {"type": "array"},
    "forbidden_patterns": {"type": "array"},
    "target_datasets": {"type": "array"},
    "expected_files": {"type": "array"},
    "verification_commands": {"type": "array"},
    "used_shared_memory_refs": {"type": "array"}
  }
}

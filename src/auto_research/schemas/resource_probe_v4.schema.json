{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evidence_id",
    "attempt_id",
    "producer_run_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_semantic_hash",
    "variant_spec_hash",
    "trial_spec_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "evaluator_hash",
    "lifecycle_generation",
    "implementation_hash",
    "attempt_input_hash",
    "phase",
    "phase_execution_id",
    "phase_start_event_id",
    "resource_type",
    "resource_id",
    "required_capacity",
    "observed_capacity",
    "unit",
    "probe_status",
    "observed_at",
    "command_id",
    "command_hash",
    "command_plan_hash",
    "receipt_ref",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_resource_probe_evidence_v4"
    },
    "evidence_kind": {
      "const": "resource_probe"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 8
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "direction_semantic_hash": {
      "$ref": "#/$defs/sha256"
    },
    "direction_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "variant_semantic_hash": {
      "$ref": "#/$defs/sha256"
    },
    "variant_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "trial_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha256"
    },
    "sample_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evaluator_hash": {
      "$ref": "#/$defs/sha256"
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "$ref": "#/$defs/sha256"
    },
    "attempt_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "enum": [
        "implementation",
        "activation",
        "proxy",
        "full",
        "resume"
      ]
    },
    "phase_execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "phase_start_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
    },
    "resource_type": {
      "enum": [
        "gpu_memory",
        "system_memory",
        "disk",
        "network",
        "quota"
      ]
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "required_capacity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "observed_capacity": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "enum": [
        "bytes",
        "count",
        "bytes_per_second"
      ]
    },
    "probe_status": {
      "enum": [
        "available",
        "insufficient"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "command_hash": {
      "$ref": "#/$defs/sha256"
    },
    "command_plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "digest",
        "size_bytes",
        "relative_path"
      ],
      "properties": {
        "schema_version": {
          "const": "auto_research_contract_blob_v1"
        },
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "relative_path": {
          "type": "string",
          "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

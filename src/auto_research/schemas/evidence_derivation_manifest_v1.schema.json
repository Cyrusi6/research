{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivation_id", "attempt_id", "lifecycle_generation", "phase", "phase_execution_id", "implementation_hash", "attempt_input_hash", "trial_spec_hash", "protocol_hash", "sample_manifest_hash", "evaluator_hash", "source_commands", "decoder", "normalized_outputs"],
  "properties": {
    "schema_version": {"const": "auto_research_evidence_derivation_manifest_v1"},
    "derivation_id": {"$ref": "#/$defs/safe_id"},
    "attempt_id": {"type": "string", "minLength": 1},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["proxy", "full"]},
    "phase_execution_id": {"$ref": "#/$defs/safe_id"},
    "implementation_hash": {"$ref": "#/$defs/hash"},
    "attempt_input_hash": {"$ref": "#/$defs/hash"},
    "trial_spec_hash": {"$ref": "#/$defs/hash"},
    "protocol_hash": {"$ref": "#/$defs/hash"},
    "sample_manifest_hash": {"$ref": "#/$defs/hash"},
    "evaluator_hash": {"$ref": "#/$defs/hash"},
    "source_commands": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command_id", "command_hash", "receipt_ref", "receipt_hash", "output_ref", "output_hash"], "properties": {"command_id": {"$ref": "#/$defs/safe_id"}, "command_hash": {"$ref": "#/$defs/hash"}, "receipt_ref": {"$ref": "#/$defs/blob"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "output_ref": {"$ref": "#/$defs/blob"}, "output_hash": {"$ref": "#/$defs/hash"}}}},
    "decoder": {"type": "object", "additionalProperties": false, "required": ["decoder_id", "decoder_version", "source_ref", "source_hash"], "properties": {"decoder_id": {"$ref": "#/$defs/safe_id"}, "decoder_version": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/blob"}, "source_hash": {"$ref": "#/$defs/hash"}}},
    "normalized_outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "contract_ref", "content_hash"], "properties": {"kind": {"type": "string", "minLength": 1}, "contract_ref": {"$ref": "#/$defs/blob"}, "content_hash": {"$ref": "#/$defs/hash"}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"], "properties": {"schema_version": {"const": "auto_research_contract_blob_v1"}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0}, "relative_path": {"type": "string", "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}}}
  }
}

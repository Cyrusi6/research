{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "profile",
    "direction_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_id",
    "variant_semantic_hash",
    "variant_spec_hash",
    "implementation_hash",
    "implementation_revisions",
    "attempt_input_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "runtime_config_hash",
    "evaluator_hash",
    "seeds",
    "attempt_kind",
    "state",
    "consumes_direction_budget",
    "reserved_slot",
    "phases",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_attempt_v2"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "profile": {
      "enum": [
        "standard",
        "bootstrap"
      ]
    },
    "direction_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previous_implementation_hash",
          "implementation_hash",
          "attempt_input_hash",
          "created_at"
        ],
        "properties": {
          "previous_implementation_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "implementation_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt_input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attempt_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "attempt_kind": {
      "enum": [
        "proxy",
        "full",
        "proxy_full",
        "bootstrap_proxy"
      ]
    },
    "state": {
      "enum": [
        "PLANNED",
        "IMPLEMENTING",
        "IMPLEMENTATION_REPAIR",
        "READY",
        "PROXY_RUNNING",
        "PROXY_COMPLETED",
        "FULL_RUNNING",
        "METHOD_COMPLETED",
        "METHOD_FAILED",
        "RESOURCE_PAUSED",
        "INTEGRITY_BLOCKED",
        "ABANDONED"
      ]
    },
    "consumes_direction_budget": {
      "type": "boolean"
    },
    "reserved_slot": {
      "type": "boolean"
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy",
        "full"
      ],
      "properties": {
        "proxy": {
          "enum": [
            "PENDING",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "SKIPPED"
          ]
        },
        "full": {
          "enum": [
            "PENDING",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "SKIPPED"
          ]
        }
      }
    },
    "method_evaluable": {
      "type": "boolean"
    },
    "terminal_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}

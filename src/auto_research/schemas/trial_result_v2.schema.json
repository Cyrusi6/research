{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_id",
    "variant_semantic_hash",
    "variant_spec_hash",
    "attempt_id",
    "protocol_hash",
    "attempt_input_hash",
    "completeness",
    "required_datasets",
    "observed_datasets",
    "raw_artifacts",
    "observations",
    "method_evaluable",
    "outcome_classification",
    "failure_classification",
    "primary_metric_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_trial_result_v2"
    },
    "direction_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completeness": {
      "enum": [
        "proxy",
        "full"
      ]
    },
    "required_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "phase",
          "role",
          "command_status",
          "dataset_id",
          "metric_id",
          "metric_value",
          "sample_manifest_hash",
          "evaluator_hash",
          "seed",
          "raw_artifact_hash"
        ],
        "properties": {
          "schema_version": {
            "const": "auto_research_execution_observation_v1"
          },
          "phase": {
            "enum": [
              "proxy",
              "full",
              "ablation"
            ]
          },
          "role": {
            "enum": [
              "baseline",
              "candidate",
              "ablation"
            ]
          },
          "command_status": {
            "enum": [
              "completed",
              "failed",
              "partial",
              "resource_paused",
              "integrity_blocked"
            ]
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_value": {
            "type": "number"
          },
          "sample_manifest_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evaluator_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "seed": {
            "type": "integer"
          },
          "raw_artifact_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "method_evaluable": {
      "const": true
    },
    "outcome_classification": {
      "enum": [
        "accepted",
        "rejected",
        "falsified",
        "inconclusive"
      ]
    },
    "failure_classification": {
      "type": "null"
    },
    "primary_metric_summary": {
      "type": "object",
      "minProperties": 1
    }
  }
}

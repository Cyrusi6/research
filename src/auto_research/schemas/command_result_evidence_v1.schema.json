{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evidence_id",
    "attempt_id",
    "producer_run_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_semantic_hash",
    "variant_spec_hash",
    "trial_spec_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "evaluator_hash",
    "lifecycle_generation",
    "implementation_hash",
    "attempt_input_hash",
    "phase",
    "phase_execution_id",
    "phase_start_event_id",
    "command_id",
    "command",
    "working_directory",
    "started_at",
    "finished_at",
    "command_status",
    "exit_code",
    "stdout_hash",
    "stderr_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_command_result_evidence_v1"
    },
    "evidence_kind": {
      "const": "command_result_evidence"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 8
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "direction_semantic_hash": {
      "$ref": "#/$defs/sha256"
    },
    "direction_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "variant_semantic_hash": {
      "$ref": "#/$defs/sha256"
    },
    "variant_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "trial_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha256"
    },
    "sample_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evaluator_hash": {
      "$ref": "#/$defs/sha256"
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "$ref": "#/$defs/sha256"
    },
    "attempt_input_hash": {
      "$ref": "#/$defs/sha256"
    },
    "phase": {
      "enum": ["implementation", "activation", "proxy", "full"]
    },
    "phase_execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "phase_start_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "command_status": {
      "enum": ["completed", "failed"]
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_hash": {
      "$ref": "#/$defs/sha256"
    },
    "stderr_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "completed"
          }
        },
        "required": ["command_status"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_status": {
            "const": "failed"
          }
        },
        "required": ["command_status"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "not": {
              "const": 0
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

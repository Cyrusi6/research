{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","command_id","command_hash","command_plan","attempt_id","lifecycle_generation","phase","phase_execution_id","phase_start_event_id","producer_run_id","implementation_hash","attempt_input_hash","authorization_hash","provenance_mode","idempotency_key"],
  "properties":{
    "schema_version":{"const":"auto_research_phase_command_v1"},
    "command_id":{"$ref":"#/$defs/safe_id"}, "command_hash":{"$ref":"#/$defs/hash"},
    "command_plan":{"type":"object","additionalProperties":false,"required":["argv","cwd","source_snapshot_hash","expected_outputs"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"cwd":{"type":"string","minLength":1},"source_snapshot_hash":{"$ref":"#/$defs/hash"},"expected_outputs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "attempt_id":{"type":"string","minLength":1}, "lifecycle_generation":{"type":"integer","minimum":0},
    "phase":{"enum":["proxy","full"]}, "phase_execution_id":{"$ref":"#/$defs/safe_id"},
    "phase_start_event_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"},
    "producer_run_id":{"$ref":"#/$defs/safe_id"}, "implementation_hash":{"$ref":"#/$defs/hash"},
    "attempt_input_hash":{"$ref":"#/$defs/hash"}, "authorization_hash":{"$ref":"#/$defs/hash"},
    "provenance_mode":{"enum":["synthetic","local_external","production"]}, "idempotency_key":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"safe_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"}}
}

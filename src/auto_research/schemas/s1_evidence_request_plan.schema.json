{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2CS1EvidenceRequestPlan",
  "type": "object",
  "required": [
    "schema_version",
    "request_plan_id",
    "evidence_requests",
    "candidate_direction_hypotheses",
    "uncertainty_axes",
    "discriminating_evidence_requests",
    "must_have_before_direction",
    "required_source_coverage",
    "retrieval_budget",
    "forbidden_outputs",
    "request_rationale"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "request_plan_id": {"type": "string"},
    "evidence_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "source_type", "query", "purpose", "top_k", "must_resolve"],
        "properties": {
          "request_id": {"type": "string"},
          "source_type": {"type": "string"},
          "query": {"type": "string"},
          "keywords": {"type": "array"},
          "purpose": {"type": "string"},
          "top_k": {"type": "integer"},
          "filters": {"type": "object"},
          "must_resolve": {"type": "boolean"}
        }
      }
    },
    "candidate_direction_hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "mechanism_axis", "integration_point", "control_signal", "why_plausible"],
        "properties": {
          "hypothesis_id": {"type": "string"},
          "mechanism_axis": {"type": "string"},
          "integration_point": {"type": "string"},
          "control_signal": {"type": "string"},
          "why_plausible": {"type": "string"},
          "uncertainty_axes": {"type": "array"}
        }
      }
    },
    "uncertainty_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["axis_id", "question"],
        "properties": {
          "axis_id": {"type": "string"},
          "question": {"type": "string"},
          "needed_sources": {"type": "array"}
        }
      }
    },
    "discriminating_evidence_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "distinguishes", "decision_if_supported", "decision_if_refuted"],
        "properties": {
          "request_id": {"type": "string"},
          "distinguishes": {"type": "array"},
          "decision_if_supported": {"type": "string"},
          "decision_if_refuted": {"type": "string"}
        }
      }
    },
    "must_have_before_direction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "purpose", "minimum"],
        "properties": {
          "source_type": {"type": "string"},
          "purpose": {"type": "string"},
          "minimum": {"type": "integer"}
        }
      }
    },
    "required_source_coverage": {"type": "object"},
    "retrieval_budget": {"type": "object"},
    "forbidden_outputs": {"type": "array"},
    "request_rationale": {"type": "string"}
  }
}

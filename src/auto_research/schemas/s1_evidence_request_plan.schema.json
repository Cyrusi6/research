{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2CS1EvidenceRequestPlan",
  "type": "object",
  "required": [
    "schema_version",
    "request_plan_id",
    "evidence_requests",
    "required_source_coverage",
    "retrieval_budget",
    "forbidden_outputs",
    "request_rationale"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "request_plan_id": {"type": "string"},
    "evidence_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "source_type", "query", "purpose", "top_k", "must_resolve"],
        "properties": {
          "request_id": {"type": "string"},
          "source_type": {"type": "string"},
          "query": {"type": "string"},
          "keywords": {"type": "array"},
          "purpose": {"type": "string"},
          "top_k": {"type": "integer"},
          "filters": {"type": "object"},
          "must_resolve": {"type": "boolean"}
        }
      }
    },
    "required_source_coverage": {"type": "object"},
    "retrieval_budget": {"type": "object"},
    "forbidden_outputs": {"type": "array"},
    "request_rationale": {"type": "string"}
  }
}

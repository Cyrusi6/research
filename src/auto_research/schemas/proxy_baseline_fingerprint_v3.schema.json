{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evidence_id",
    "attempt_id",
    "producer_run_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_semantic_hash",
    "variant_spec_hash",
    "trial_spec_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "evaluator_hash",
    "cross_references",
    "baseline_hash",
    "dataset_ids",
    "seeds",
    "fingerprint_inputs",
    "lifecycle_generation",
    "implementation_hash",
    "attempt_input_hash",
    "phase",
    "phase_execution_id",
    "phase_start_event_id"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_proxy_baseline_fingerprint_v3"
    },
    "evidence_kind": {
      "const": "proxy_baseline_fingerprint"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 8
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 8
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cross_references": {
      "type": "object",
      "additionalProperties": false
    },
    "baseline_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "fingerprint_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_manifest_hash",
        "evaluator_hash",
        "protocol_hash",
        "phase_execution_id"
      ],
      "properties": {
        "sample_manifest_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocol_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase_execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
        }
      }
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "activation",
        "proxy",
        "full",
        "resource",
        "resume"
      ]
    },
    "phase_execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "phase_start_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
    }
  }
}

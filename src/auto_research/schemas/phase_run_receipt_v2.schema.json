{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","command_id","command_hash","started_event_id","started_event_hash","attempt_id","lifecycle_generation","phase","phase_execution_id","phase_start_event_id","producer_run_id","implementation_hash","attempt_input_hash","provenance_mode","started_at","completed_at","exit_code","stdout_hash","stderr_hash","external_job_id","outputs"],
  "properties":{
    "schema_version":{"const":"auto_research_phase_run_receipt_v2"}, "command_id":{"$ref":"#/$defs/safe_id"},
    "command_hash":{"$ref":"#/$defs/hash"}, "started_event_id":{"type":"string","minLength":1}, "started_event_hash":{"$ref":"#/$defs/hash"},
    "attempt_id":{"type":"string","minLength":1}, "lifecycle_generation":{"type":"integer","minimum":0}, "phase":{"enum":["proxy","full"]},
    "phase_execution_id":{"$ref":"#/$defs/safe_id"}, "phase_start_event_id":{"type":"string","minLength":1}, "producer_run_id":{"$ref":"#/$defs/safe_id"},
    "implementation_hash":{"$ref":"#/$defs/hash"}, "attempt_input_hash":{"$ref":"#/$defs/hash"},
    "provenance_mode":{"enum":["synthetic","local_external","production"]},
    "started_at":{"type":"string","format":"date-time"}, "completed_at":{"type":"string","format":"date-time"}, "exit_code":{"type":"integer"},
    "stdout_hash":{"$ref":"#/$defs/hash"}, "stderr_hash":{"$ref":"#/$defs/hash"}, "external_job_id":{"type":["string","null"],"minLength":1},
    "outputs":{"type":"array","items":{"$ref":"#/$defs/blob"}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}, "safe_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "blob":{"type":"object","additionalProperties":false,"required":["schema_version","algorithm","digest","size_bytes","relative_path"],"properties":{"schema_version":{"const":"auto_research_contract_blob_v1"},"algorithm":{"const":"sha256"},"digest":{"$ref":"#/$defs/hash"},"size_bytes":{"type":"integer","minimum":0},"relative_path":{"type":"string","pattern":"^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}}}
  }
}

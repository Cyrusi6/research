{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_id",
    "variant_semantic_hash",
    "variant_spec_hash",
    "variation_coordinates",
    "intervention",
    "hypothesis",
    "null_hypothesis",
    "alternative_hypothesis",
    "controlled_variables",
    "nuisance_variables",
    "implementation_surface_ids",
    "expected_metric_signature",
    "falsification_conditions",
    "ablation",
    "resource_budget",
    "failure_routing",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_variant_v4"
    },
    "direction_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variation_coordinates": {
      "type": "object",
      "minProperties": 1
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "algorithm_operations",
        "configuration"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "algorithm_operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configuration": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "null_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "alternative_hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "controlled_variables": {
      "type": "object",
      "minProperties": 1
    },
    "nuisance_variables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_metric_signature": {
      "type": "object",
      "minProperties": 1
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ablation": {
      "type": "object",
      "minProperties": 1
    },
    "resource_budget": {
      "type": "object",
      "minProperties": 1
    },
    "failure_routing": {
      "type": "object",
      "minProperties": 1
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s2_run_id",
        "iteration",
        "direction_spec_hash",
        "feedback_from_attempt_ids"
      ],
      "properties": {
        "s2_run_id": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "direction_spec_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "feedback_from_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

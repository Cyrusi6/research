{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "phase",
    "adapter_identity",
    "variant_spec_hash",
    "source_snapshot_hash",
    "derivation_plan",
    "derivation_plan_ref",
    "derivation_plan_hash",
    "readiness_check_plan",
    "readiness_check_plan_ref",
    "readiness_check_plan_hash",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_phase_command_plan_v3"
    },
    "plan_id": {
      "$ref": "#/$defs/safe_id"
    },
    "phase": {
      "enum": [
        "proxy",
        "full"
      ]
    },
    "adapter_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "provenance_mode"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/safe_id"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance_mode": {
          "enum": [
            "synthetic",
            "local-external",
            "production"
          ]
        }
      }
    },
    "variant_spec_hash": {
      "$ref": "#/$defs/hash"
    },
    "source_snapshot_hash": {
      "$ref": "#/$defs/hash"
    },
    "derivation_plan": {"type": "object"},
    "derivation_plan_ref": {"$ref": "#/$defs/blob"},
    "derivation_plan_hash": {"$ref": "#/$defs/hash"},
    "readiness_check_plan": {"type": ["object", "null"]},
    "readiness_check_plan_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blob"}]},
    "readiness_check_plan_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command_spec"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "kind",
        "schema_version",
        "required",
        "output_role",
        "normalized_kinds",
        "role",
        "dataset_id"
      ],
      "properties": {
        "output_id": {"$ref": "#/$defs/safe_id"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "schema_version": {
          "type": "string",
          "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"
        },
        "required": {
          "type": "boolean"
        },
        "output_role": {"enum": ["physical_raw", "normalized_evidence", "derivation_manifest"]},
        "normalized_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"}},
        "role": {"type": ["string", "null"]},
        "dataset_id": {"type": ["string", "null"]}
      }
    },
    "command_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_spec_id",
        "phase",
        "ordinal",
        "authority_role",
        "dependencies",
        "argv",
        "environment",
        "inherited_environment",
        "cwd",
        "source_snapshot_hash",
        "expected_outputs",
        "physical_raw_outputs",
        "resource_policy",
        "retry_policy",
        "resume_policy",
        "condition"
      ],
      "properties": {
        "command_spec_id": {
          "$ref": "#/$defs/safe_id"
        },
        "phase": {
          "enum": [
            "proxy",
            "full"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "authority_role": {"enum": ["physical", "derivation"]},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_id"
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "source_snapshot_hash": {
          "$ref": "#/$defs/hash"
        },
        "expected_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "physical_raw_outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/physical_raw_output"}
        },
        "derivation_plan_ref": {"$ref": "#/$defs/blob"},
        "derivation_plan_hash": {"$ref": "#/$defs/hash"},
        "resource_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource_class",
            "minimum_capacity",
            "unit"
          ],
          "properties": {
            "resource_class": {
              "enum": [
                "cpu",
                "gpu_memory",
                "system_memory",
                "disk",
                "network",
                "quota"
              ]
            },
            "minimum_capacity": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "count",
                "bytes",
                "bytes_per_second"
              ]
            }
          }
        },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "retryable_exit_codes",
            "backoff_seconds"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "retryable_exit_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            },
            "backoff_seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            }
          }
        },
        "resume_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "external_job_attach_required"
          ],
          "properties": {
            "mode": {
              "enum": [
                "receipt_only",
                "attach_external_job",
                "never"
              ]
            },
            "external_job_attach_required": {
              "type": "boolean"
            }
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "predicate_hash"
          ],
          "properties": {
            "kind": {
              "enum": [
                "always",
                "proxy_route",
                "artifact_present"
              ]
            },
            "predicate_hash": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/hash"
                }
              ]
            }
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "inherited_environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "HOME",
              "PATH",
              "TMPDIR",
              "LANG",
              "LC_ALL",
              "TZ"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"authority_role": {"const": "derivation"}}},
          "then": {"required": ["derivation_plan_ref", "derivation_plan_hash"]},
          "else": {"not": {"anyOf": [{"required": ["derivation_plan_ref"]}, {"required": ["derivation_plan_hash"]}]}}
        }
      ]
    },
    "physical_raw_output": {
      "type": "object", "additionalProperties": false,
      "required": ["output_id", "kind", "schema_version", "locator", "locator_type", "dataset_id", "role", "required", "normalized_kinds"],
      "properties": {
        "output_id": {"$ref": "#/$defs/safe_id"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "schema_version": {"type": "string", "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"},
        "locator": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "locator_type": {"enum": ["file", "tree"]},
        "dataset_id": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "required": {"type": "boolean"},
        "normalized_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"}}
      }
    }
    ,
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"],
      "properties": {
        "schema_version": {"const": "auto_research_contract_blob_v1"},
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "relative_path": {"type": "string", "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}
      }
    }
  }
}

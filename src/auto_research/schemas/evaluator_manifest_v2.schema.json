{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluator_id", "provenance_mode", "source_blobs", "dependency_blobs", "config_blob", "config_digest", "source_digest", "dependency_digest"],
  "properties": {
    "schema_version": {"const": "auto_research_evaluator_manifest_v2"},
    "evaluator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "provenance_mode": {"enum": ["real", "synthetic"]},
    "source_blobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blob"}},
    "dependency_blobs": {"type": "array", "items": {"$ref": "#/$defs/blob"}},
    "config_blob": {"$ref": "#/$defs/blob"},
    "config_digest": {"$ref": "#/$defs/hash"},
    "source_digest": {"$ref": "#/$defs/hash"},
    "dependency_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"],
      "properties": {
        "schema_version": {"const": "auto_research_contract_blob_v1"},
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "relative_path": {"type": "string", "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}
      }
    }
  }
}

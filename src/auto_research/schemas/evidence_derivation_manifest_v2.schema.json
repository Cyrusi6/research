{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derivation_id", "derivation_plan_ref", "derivation_plan_hash", "attempt_id", "lifecycle_generation", "phase", "phase_execution_id", "producer_run_id", "implementation_hash", "attempt_input_hash", "trial_spec_hash", "protocol_hash", "sample_manifest_hash", "evaluator_hash", "source_commands", "decoder_descriptor", "normalized_outputs"],
  "properties": {
    "schema_version": {"const": "auto_research_evidence_derivation_manifest_v2"},
    "derivation_id": {"$ref": "#/$defs/safe_id"},
    "derivation_plan_ref": {"$ref": "#/$defs/blob"},
    "derivation_plan_hash": {"$ref": "#/$defs/hash"},
    "attempt_id": {"type": "string", "minLength": 1},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["proxy", "full"]},
    "phase_execution_id": {"$ref": "#/$defs/safe_id"},
    "producer_run_id": {"$ref": "#/$defs/safe_id"},
    "implementation_hash": {"$ref": "#/$defs/hash"},
    "attempt_input_hash": {"$ref": "#/$defs/hash"},
    "trial_spec_hash": {"$ref": "#/$defs/hash"},
    "protocol_hash": {"$ref": "#/$defs/hash"},
    "sample_manifest_hash": {"$ref": "#/$defs/hash"},
    "evaluator_hash": {"$ref": "#/$defs/hash"},
    "source_commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_ordinal", "command_id", "command_spec_id", "command_hash", "completed_event_id", "receipt_ref", "receipt_hash", "output_id", "output_kind", "output_schema_version", "output_ref", "output_hash"],
        "properties": {
          "source_ordinal": {"type": "integer", "minimum": 0},
          "command_id": {"$ref": "#/$defs/safe_id"},
          "command_spec_id": {"$ref": "#/$defs/safe_id"},
          "command_hash": {"$ref": "#/$defs/hash"},
          "completed_event_id": {"type": "string", "minLength": 1},
          "receipt_ref": {"$ref": "#/$defs/blob"},
          "receipt_hash": {"$ref": "#/$defs/hash"},
          "output_id": {"$ref": "#/$defs/safe_id"},
          "output_kind": {"type": "string", "minLength": 1},
          "output_schema_version": {"type": "string", "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"},
          "output_ref": {"$ref": "#/$defs/blob"},
          "output_hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "decoder_descriptor": {"$ref": "#/$defs/decoder"},
    "normalized_outputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordinal", "output_id", "kind", "schema_version", "contract_ref", "content_hash"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "output_id": {"$ref": "#/$defs/safe_id"},
          "kind": {"type": "string", "minLength": 1},
          "schema_version": {"type": "string", "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"},
          "contract_ref": {"$ref": "#/$defs/blob"},
          "content_hash": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "decoder": {"type": "object", "additionalProperties": false, "required": ["schema_version", "decoder_id", "decoder_version", "semantic_hash", "implementation_hash", "immutable_ref"], "properties": {"schema_version": {"const": "auto_research_decoder_descriptor_v1"}, "decoder_id": {"enum": ["canonical-identity", "c2c-receipt-measurements"]}, "decoder_version": {"type": "string", "minLength": 1}, "semantic_hash": {"$ref": "#/$defs/hash"}, "implementation_hash": {"$ref": "#/$defs/hash"}, "immutable_ref": {"$ref": "#/$defs/blob"}}},
    "blob": {"type": "object", "additionalProperties": false, "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"], "properties": {"schema_version": {"const": "auto_research_contract_blob_v1"}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 1}, "relative_path": {"type": "string", "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}}}
  }
}

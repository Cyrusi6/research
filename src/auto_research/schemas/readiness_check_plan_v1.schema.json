{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "phase", "checks", "route_semantics"],
  "properties": {
    "schema_version": {"const": "auto_research_readiness_check_plan_v1"},
    "plan_id": {"$ref": "#/$defs/safe_id"},
    "phase": {"enum": ["proxy", "full"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordinal", "check_id", "check_kind", "source_bindings", "predicate", "required_coverage", "decoder_descriptor", "blocked_classification", "blocked_route"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "check_id": {"$ref": "#/$defs/safe_id"},
          "check_kind": {"enum": ["activation_delta", "raw_measurement"]},
          "source_bindings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_ordinal", "source_phase", "command_spec_id", "output_id", "output_kind", "output_schema_version"],
              "properties": {
                "source_ordinal": {"type": "integer", "minimum": 0},
                "source_phase": {"enum": ["proxy", "full"]},
                "command_spec_id": {"$ref": "#/$defs/safe_id"},
                "output_id": {"$ref": "#/$defs/safe_id"},
                "output_kind": {"type": "string", "minLength": 1},
                "output_schema_version": {"type": "string", "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"}
              }
            }
          },
          "predicate": {
            "type": "object", "additionalProperties": false,
            "required": ["field_path", "comparator", "threshold"],
            "properties": {
              "field_path": {"type": "string", "minLength": 1},
              "comparator": {"enum": ["eq", "gt", "gte", "lt", "lte", "delta_gte", "exact_set"]},
              "threshold": {"type": ["number", "boolean", "string", "array"]}
            }
          },
          "required_coverage": {
            "type": "object", "additionalProperties": false,
            "required": ["mode", "expected_surface_ids"],
            "properties": {
              "mode": {"enum": ["exact", "at_least"]},
              "expected_surface_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "decoder_descriptor": {"$ref": "#/$defs/decoder"},
          "blocked_classification": {"const": "IMPLEMENTATION_BLOCKED"},
          "blocked_route": {"const": "REPAIR_IMPLEMENTATION"}
        }
      }
    },
    "route_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["integrity_invalid", "resource_insufficient", "semantic_blocked", "all_pass"],
      "properties": {
        "integrity_invalid": {"const": "BLOCK_INTEGRITY"},
        "resource_insufficient": {"const": "PAUSE_RESOURCE"},
        "semantic_blocked": {"const": "REPAIR_IMPLEMENTATION"},
        "all_pass": {"const": "CONTINUE_PROXY_DECISION"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "blob": {"type": "object", "additionalProperties": false, "required": ["schema_version", "algorithm", "digest", "size_bytes", "relative_path"], "properties": {"schema_version": {"const": "auto_research_contract_blob_v1"}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 1}, "relative_path": {"type": "string", "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}}},
    "decoder": {"type": "object", "additionalProperties": false, "required": ["schema_version", "decoder_id", "decoder_version", "semantic_hash", "implementation_hash", "immutable_ref"], "properties": {"schema_version": {"const": "auto_research_decoder_descriptor_v1"}, "decoder_id": {"enum": ["canonical-identity", "c2c-receipt-measurements"]}, "decoder_version": {"type": "string", "minLength": 1}, "semantic_hash": {"$ref": "#/$defs/hash"}, "implementation_hash": {"$ref": "#/$defs/hash"}, "immutable_ref": {"$ref": "#/$defs/blob"}}}
  }
}

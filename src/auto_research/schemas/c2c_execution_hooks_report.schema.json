{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2CExecutionHooksReport",
  "type": "object",
  "required": ["schema_version", "project_id", "gate", "checks", "commands", "blocking_reasons", "warnings"],
  "properties": {
    "schema_version": {"type": "string", "const": "c2c_execution_hooks_report_v1"},
    "created_at": {"type": "string"},
    "project_id": {"type": "string"},
    "gate": {"type": "string", "enum": ["pass", "fail"]},
    "checks": {
      "type": "object",
      "required": [
        "env_python_runs",
        "target_repo_importable",
        "eval_entrypoint_exists",
        "eval_help_command_passed",
        "dataset_one_example_loadable",
        "output_dir_writable",
        "command_timeout_configured"
      ]
    },
    "commands": {"type": "array"},
    "blocking_reasons": {"type": "array"},
    "warnings": {"type": "array"},
    "paths": {"type": "object"}
  },
  "additionalProperties": true
}

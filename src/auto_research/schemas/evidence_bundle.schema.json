{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearchEvidenceBundleContract",
  "type": "object",
  "required": ["items"],
  "properties": {
    "schema_version": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "summary"],
        "properties": {
          "chunk_id": {"type": "string"},
          "source_path": {"type": "string"},
          "source_type": {"type": "string"},
          "summary": {"type": "string"},
          "supports": {"type": "array"},
          "risks": {"type": "array"}
        }
      }
    }
  }
}

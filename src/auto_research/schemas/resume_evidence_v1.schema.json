{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "lifecycle_generation", "implementation_hash", "attempt_input_hash", "resource_type", "probe_status", "artifact", "observed_at"],
  "properties": {
    "schema_version": {"const": "auto_research_resume_evidence_v1"},
    "attempt_id": {"type": "string", "pattern": "^[a-f0-9-]{36}$"},
    "lifecycle_generation": {"type": "integer", "minimum": 0},
    "implementation_hash": {"$ref": "#/$defs/hash"},
    "attempt_input_hash": {"$ref": "#/$defs/hash"},
    "resource_type": {"type": "string", "minLength": 1},
    "probe_status": {"const": "available"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "observed_at": {"type": "string", "minLength": 1}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

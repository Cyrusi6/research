{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_semantic_hash",
    "variant_spec_hash",
    "trial_spec_hash",
    "protocol_hash",
    "sample_manifest_hash",
    "evaluator_hash",
    "entries",
    "lifecycle_generation",
    "implementation_hash",
    "attempt_input_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_evidence_manifest_v3"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluator_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "relative_path",
          "content_hash",
          "schema_version",
          "attempt_id",
          "producer_run_id",
          "direction_semantic_hash",
          "direction_spec_hash",
          "variant_semantic_hash",
          "variant_spec_hash",
          "trial_spec_hash",
          "protocol_hash",
          "sample_manifest_hash",
          "evaluator_hash",
          "cross_references",
          "lifecycle_generation",
          "implementation_hash",
          "attempt_input_hash",
          "phase",
          "phase_execution_id",
          "phase_start_event_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
          },
          "kind": {
            "enum": [
              "main_results",
              "ablation_results",
              "coverage_results",
              "matched_control_results",
              "activation_evidence",
              "proxy_baseline_fingerprint",
              "proxy_cache_report",
              "full_s3_readiness",
              "bootstrap_completion",
              "proxy_results"
            ]
          },
          "relative_path": {
            "type": "string",
            "pattern": "^experiment/attempts/[^/]+/[^/]+/[^/]+/[a-f0-9]{64}\\.json$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_version": {
            "type": "string",
            "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
          },
          "direction_semantic_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "direction_spec_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "variant_semantic_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "variant_spec_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "trial_spec_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "protocol_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sample_manifest_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evaluator_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "cross_references": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*_hash$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "lifecycle_generation": {
            "type": "integer",
            "minimum": 0
          },
          "implementation_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attempt_input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "phase": {
            "enum": [
              "activation",
              "proxy",
              "full",
              "resource",
              "resume"
            ]
          },
          "phase_execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
          },
          "phase_start_event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
          }
        }
      }
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

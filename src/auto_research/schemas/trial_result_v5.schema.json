{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "variant_id",
    "variant_semantic_hash",
    "variant_spec_hash",
    "attempt_id",
    "trial_spec_hash",
    "acceptance_contract_hash",
    "protocol_hash",
    "attempt_input_hash",
    "completeness",
    "required_datasets",
    "observed_datasets",
    "raw_artifacts",
    "evidence_manifest",
    "observations",
    "constraint_results",
    "all_hard_constraints_passed",
    "method_evaluable",
    "outcome_classification",
    "failure_classification",
    "primary_metric_summary",
    "lifecycle_generation",
    "implementation_hash",
    "evidence_manifest_hash",
    "proxy_outcome_event_id",
    "proxy_outcome_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_trial_result_v5"
    },
    "direction_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "direction_spec_hash": {
      "$ref": "#/$defs/hash"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "variant_spec_hash": {
      "$ref": "#/$defs/hash"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "trial_spec_hash": {
      "$ref": "#/$defs/hash"
    },
    "acceptance_contract_hash": {
      "$ref": "#/$defs/hash"
    },
    "protocol_hash": {
      "$ref": "#/$defs/hash"
    },
    "attempt_input_hash": {
      "$ref": "#/$defs/hash"
    },
    "completeness": {
      "enum": [
        "proxy",
        "full"
      ]
    },
    "required_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^experiment/attempts/[^/]+/[^/]+/[^/]+/[a-f0-9]{64}\\.json$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "evidence_manifest": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "constraint_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "all_hard_constraints_passed": {
      "type": "boolean"
    },
    "method_evaluable": {
      "const": true
    },
    "outcome_classification": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "failure_classification": {
      "type": "null"
    },
    "primary_metric_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "objective",
        "aggregation",
        "candidate_mean",
        "baseline_mean",
        "delta",
        "paired_count",
        "paired_improvements"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "aggregation": {
          "const": "mean"
        },
        "candidate_mean": {
          "type": "number"
        },
        "baseline_mean": {
          "type": "number"
        },
        "delta": {
          "type": "number"
        },
        "paired_count": {
          "type": "integer",
          "minimum": 1
        },
        "paired_improvements": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^.+:[0-9]+$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proxy_outcome_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "proxy_outcome_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

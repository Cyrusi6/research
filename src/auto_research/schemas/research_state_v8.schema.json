{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "last_sequence",
    "last_event_hash",
    "directions",
    "excluded_direction_semantic_hashes",
    "variants",
    "attempts",
    "trial_results",
    "proxy_outcomes",
    "phase_authorizations",
    "phase_commands",
    "method_tried_history",
    "implementation_history",
    "operation_events",
    "current_direction_semantic_hash",
    "current_variant_spec_hash",
    "last_route_outcome",
    "latest_trial_result",
    "latest_direction_aggregate",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_state_v8"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "directions": {
      "type": "object"
    },
    "excluded_direction_semantic_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "variants": {
      "type": "object"
    },
    "attempts": {
      "type": "object"
    },
    "trial_results": {
      "type": "object"
    },
    "proxy_outcomes": {
      "type": "object"
    },
    "phase_authorizations": {
      "type": "object"
    },
    "phase_commands": {
      "type": "object"
    },
    "method_tried_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "implementation_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operation_events": {
      "type": "object"
    },
    "current_direction_semantic_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_variant_spec_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_route_outcome": {
      "type": [
        "object",
        "null"
      ]
    },
    "latest_trial_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "latest_direction_aggregate": {
      "type": [
        "object",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

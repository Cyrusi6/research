{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "command_hash",
    "command_spec_id",
    "command_plan_hash",
    "started_event_id",
    "started_event_hash",
    "attempt_id",
    "lifecycle_generation",
    "phase",
    "phase_execution_id",
    "phase_start_event_id",
    "producer_run_id",
    "implementation_hash",
    "attempt_input_hash",
    "provenance_mode",
    "receipt_locator",
    "started_at",
    "completed_at",
    "exit_code",
    "stdout_hash",
    "stderr_hash",
    "stdout_ref",
    "stderr_ref",
    "external_job_id",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_phase_run_receipt_v3"
    },
    "command_id": {
      "$ref": "#/$defs/safe_id"
    },
    "command_hash": {
      "$ref": "#/$defs/hash"
    },
    "command_spec_id": {
      "$ref": "#/$defs/safe_id"
    },
    "command_plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "started_event_id": {
      "type": "string",
      "minLength": 1
    },
    "started_event_hash": {
      "$ref": "#/$defs/hash"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "proxy",
        "full"
      ]
    },
    "phase_execution_id": {
      "$ref": "#/$defs/safe_id"
    },
    "phase_start_event_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "$ref": "#/$defs/safe_id"
    },
    "implementation_hash": {
      "$ref": "#/$defs/hash"
    },
    "attempt_input_hash": {
      "$ref": "#/$defs/hash"
    },
    "provenance_mode": {
      "enum": [
        "synthetic",
        "local-external",
        "production"
      ]
    },
    "receipt_locator": {
      "type": "string",
      "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_hash": {
      "$ref": "#/$defs/hash"
    },
    "stderr_hash": {
      "$ref": "#/$defs/hash"
    },
    "stdout_ref": {
      "$ref": "#/$defs/blob_ref"
    },
    "stderr_ref": {
      "$ref": "#/$defs/blob_ref"
    },
    "external_job_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "schema_version",
          "content_hash",
          "contract_ref",
          "producer_run_id",
          "phase",
          "lifecycle_generation"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "pattern": "^auto_research_[a-z0-9_]+_v[0-9]+$"
          },
          "content_hash": {
            "$ref": "#/$defs/hash"
          },
          "contract_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "algorithm",
              "digest",
              "size_bytes",
              "relative_path"
            ],
            "properties": {
              "schema_version": {
                "const": "auto_research_contract_blob_v1"
              },
              "algorithm": {
                "const": "sha256"
              },
              "digest": {
                "$ref": "#/$defs/hash"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "relative_path": {
                "type": "string",
                "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
              }
            }
          },
          "producer_run_id": {
            "$ref": "#/$defs/safe_id"
          },
          "phase": {
            "enum": [
              "proxy",
              "full"
            ]
          },
          "lifecycle_generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "blob_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "digest",
        "size_bytes",
        "relative_path"
      ],
      "properties": {
        "schema_version": {
          "const": "auto_research_contract_blob_v1"
        },
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "relative_path": {
          "type": "string",
          "pattern": "^meta/contracts/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoResearchPlanContract",
  "type": "object",
  "required": ["hypotheses", "baselines", "datasets", "task_graph", "resource_budget"],
  "properties": {
    "hypotheses": {"type": "array", "minItems": 1},
    "baselines": {"type": "array", "minItems": 2},
    "datasets": {"type": "array", "minItems": 1},
    "task_graph": {"type": "object"},
    "resource_budget": {"type": "object"},
    "execution": {"type": "object"},
    "acceptance_criteria": {},
    "reviewer_risk_controls": {"type": "object"}
  }
}

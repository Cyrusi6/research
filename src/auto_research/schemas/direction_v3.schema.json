{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction_id",
    "direction_semantic_hash",
    "direction_spec_hash",
    "research_question",
    "mechanism_invariants",
    "falsification_conditions",
    "support_claim_ids",
    "counter_claim_ids",
    "implementation_surface_ids",
    "metric_signature",
    "benchmark_contract_hash",
    "variant_space",
    "exploration_policy",
    "s2_entry_conditions",
    "return_to_s1_conditions",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "auto_research_direction_v3"
    },
    "direction_id": {
      "type": "string",
      "minLength": 1
    },
    "direction_semantic_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "direction_spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "mechanism_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causal_hypothesis",
        "target_mediator",
        "invariants"
      ],
      "properties": {
        "causal_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "target_mediator": {
          "type": "string",
          "minLength": 1
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "support_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counter_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_surface_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric_signature": {
      "type": "object",
      "minProperties": 1
    },
    "benchmark_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variant_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutable_axes",
        "immutable_axes",
        "forbidden_combinations"
      ],
      "properties": {
        "mutable_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "immutable_axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_combinations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "exploration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_outcome_bearing_variants",
        "execution_width",
        "stop_on_success",
        "budget_consumption_rule",
        "non_consuming_outcomes"
      ],
      "properties": {
        "target_outcome_bearing_variants": {
          "const": 5
        },
        "execution_width": {
          "const": 1
        },
        "stop_on_success": {
          "const": false
        },
        "budget_consumption_rule": {
          "type": "string",
          "minLength": 1
        },
        "non_consuming_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "s2_entry_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "return_to_s1_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s1_run_id",
        "iteration",
        "input_manifest_hash"
      ],
      "properties": {
        "s1_run_id": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "input_manifest_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
